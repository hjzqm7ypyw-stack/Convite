        <!-- ==================== SEÇÃO LISTA DE PRESENTES ==================== -->
        <section id="presentes" class="bg-beige-section py-16 sm:py-24 px-4 sm:px-6 border-t border-b border-beige-border/50">
            <div class="max-w-4xl mx-auto text-center">
                <!-- Cabeçalho da Seção -->
                <p class="text-[11px] sm:text-xs tracking-[0.26em] uppercase text-[#7A6A5C] font-medium mb-2">
                    UM GESTO DE CARINHO
                </p>
                <h2 class="text-3xl sm:text-4xl font-medium text-burgundy mb-3">
                    Lista de presentes
                </h2>
                <p class="text-base sm:text-lg text-[#584A3E] max-w-xl mx-auto leading-relaxed mb-10 sm:mb-12">
                    O maior presente é celebrar com você. Se desejar, escolha uma das sugestões abaixo e conte-nos na confirmação de presença.
                </p>

                <!-- Grid com os 3 Cards Interativos -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 text-left">
                    
                    <!-- Card 1: Jantar especial -->
                    <div role="checkbox" aria-checked="false" tabindex="0" data-gift="Jantar especial"
                         class="gift-card group cursor-pointer bg-cream-light hover:bg-white border border-beige-border rounded-[6px] p-6 sm:p-7 shadow-soft transition-all duration-200 flex flex-col justify-between select-none">
                        <div>
                            <!-- Ícone Prato e Talheres -->
                            <div class="w-10 h-10 mb-4 flex items-center justify-start text-2xl" aria-hidden="true">
                                <svg class="w-8 h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <!-- Garfo -->
                                    <path d="M7 6V13C7 14.6569 8.34315 16 10 16V30" stroke="#7A869A" stroke-width="1.8" stroke-linecap="round"/>
                                    <path d="M5 6V11.5C5 12.8807 6.11929 14 7.5 14H10.5C11.8807 14 13 12.8807 13 11.5V6" stroke="#7A869A" stroke-width="1.8" stroke-linecap="round"/>
                                    <path d="M9 6V13" stroke="#7A869A" stroke-width="1.8" stroke-linecap="round"/>
                                    <!-- Prato -->
                                    <circle cx="19" cy="18" r="8.5" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1.5"/>
                                    <circle cx="19" cy="18" r="5.2" stroke="#CBD5E1" stroke-width="1.2"/>
                                    <!-- Faca -->
                                    <path d="M30 6C31.5 9 31.5 14 30 17V30" stroke="#7A869A" stroke-width="1.8" stroke-linecap="round"/>
                                    <path d="M30 6V17" stroke="#7A869A" stroke-width="1.8" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <h3 class="text-lg sm:text-xl font-bold text-[#3B2E26] mb-1.5 group-hover:text-burgundy transition-colors">
                                Jantar especial
                            </h3>
                            <p class="text-sm sm:text-base text-[#5E5045] leading-snug mb-6">
                                Uma sugestão para nossos momentos à mesa.
                            </p>
                        </div>

                        <label class="inline-flex items-center space-x-2.5 cursor-pointer pt-2">
                            <input type="checkbox" class="custom-checkbox gift-checkbox" value="Jantar especial" tabindex="-1">
                            <span class="text-sm sm:text-[0.95rem] font-medium text-[#4A3B32] group-hover:text-burgundy transition-colors">
                                Selecionar opção
                            </span>
                        </label>
                    </div>

                    <!-- Card 2: Nosso novo lar -->
                    <div role="checkbox" aria-checked="false" tabindex="0" data-gift="Nosso novo lar"
                         class="gift-card group cursor-pointer bg-cream-light hover:bg-white border border-beige-border rounded-[6px] p-6 sm:p-7 shadow-soft transition-all duration-200 flex flex-col justify-between select-none">
                        <div>
                            <!-- Ícone Casinha -->
                            <div class="w-10 h-10 mb-4 flex items-center justify-start" aria-hidden="true">
                                <svg class="w-8 h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <!-- Árvore lateral -->
                                    <circle cx="7" cy="21" r="4" fill="#86EFAC" stroke="#4ADE80" stroke-width="1.2"/>
                                    <path d="M7 25V29" stroke="#78350F" stroke-width="1.6" stroke-linecap="round"/>
                                    <!-- Corpo da casa -->
                                    <path d="M11 17L20 10L29 17V29H11V17Z" fill="#FEF3C7" stroke="#D97706" stroke-width="1.4" stroke-linejoin="round"/>
                                    <!-- Telhado -->
                                    <path d="M9 18L20 9L31 18" stroke="#B91C1C" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                                    <!-- Porta e Janela -->
                                    <rect x="18" y="21" width="4" height="8" rx="0.5" fill="#92400E"/>
                                    <rect x="23.5" y="19" width="3" height="3" rx="0.5" fill="#BAE6FD" stroke="#0284C7" stroke-width="1"/>
                                </svg>
                            </div>
                            <h3 class="text-lg sm:text-xl font-bold text-[#3B2E26] mb-1.5 group-hover:text-burgundy transition-colors">
                                Nosso novo lar
                            </h3>
                            <p class="text-sm sm:text-base text-[#5E5045] leading-snug mb-6">
                                Um carinho para esta nova etapa juntos.
                            </p>
                        </div>

                        <label class="inline-flex items-center space-x-2.5 cursor-pointer pt-2">
                            <input type="checkbox" class="custom-checkbox gift-checkbox" value="Nosso novo lar" tabindex="-1">
                            <span class="text-sm sm:text-[0.95rem] font-medium text-[#4A3B32] group-hover:text-burgundy transition-colors">
                                Selecionar opção
                            </span>
                        </label>
                    </div>

                    <!-- Card 3: Lua de mel -->
                    <div role="checkbox" aria-checked="false" tabindex="0" data-gift="Lua de mel"
                         class="gift-card group cursor-pointer bg-cream-light hover:bg-white border border-beige-border rounded-[6px] p-6 sm:p-7 shadow-soft transition-all duration-200 flex flex-col justify-between select-none">
                        <div>
                            <!-- Ícone Avião -->
                            <div class="w-10 h-10 mb-4 flex items-center justify-start" aria-hidden="true">
                                <svg class="w-8 h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M29.5 6.5C30.3 7.3 30.3 8.6 29.5 9.4L22.8 16.1L26.2 28.5L23.8 30.9L18.2 20.7L12.5 26.4L13.4 30.1L11.6 31.9L9.2 27.6L4.9 25.2L6.7 23.4L10.4 24.3L16.1 18.6L5.9 13L8.3 10.6L20.7 14L27.4 7.3C28.2 6.5 29.5 6.5 29.5 6.5Z" fill="#BAE6FD" stroke="#0284C7" stroke-width="1.5" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <h3 class="text-lg sm:text-xl font-bold text-[#3B2E26] mb-1.5 group-hover:text-burgundy transition-colors">
                                Lua de mel
                            </h3>
                            <p class="text-sm sm:text-base text-[#5E5045] leading-snug mb-6">
                                Uma lembrança para nossa primeira viagem.
                            </p>
                        </div>

                        <label class="inline-flex items-center space-x-2.5 cursor-pointer pt-2">
                            <input type="checkbox" class="custom-checkbox gift-checkbox" value="Lua de mel" tabindex="-1">
                            <span class="text-sm sm:text-[0.95rem] font-medium text-[#4A3B32] group-hover:text-burgundy transition-colors">
                                Selecionar opção
                            </span>
                        </label>
                    </div>

                </div>

                <!-- Nota Informativa abaixo dos cards -->
                <p class="text-xs sm:text-sm text-[#6C5D50] mt-8 sm:mt-10">
                    Selecionar uma opção apenas registra sua preferência; não realiza pagamento nem reserva o presente.
                </p>
            </div>
        </section>

        <!-- ==================== SEÇÃO CONFIRMAÇÃO DE PRESENÇA (RSVP) ==================== -->
        <section id="confirmar" class="bg-cream-base py-16 sm:py-24 px-4 sm:px-6">
            <div class="max-w-xl mx-auto">
                <!-- Cabeçalho da Seção -->
                <div class="text-center mb-10">
                    <p class="text-[11px] sm:text-xs tracking-[0.26em] uppercase text-[#7A6A5C] font-medium mb-2">
                        ESPERAMOS POR VOCÊ
                    </p>
                    <h2 class="text-3xl sm:text-4xl font-medium text-burgundy mb-2.5">
                        Confirme sua presença
                    </h2>
                    <p class="text-base sm:text-lg text-[#584A3E]">
                        Preencha os campos abaixo para enviar sua resposta.
                    </p>
                </div>

                <!-- Card do Formulário -->
                <div id="rsvp-card-container" class="bg-cream-light border border-beige-border rounded-[6px] p-6 sm:p-10 shadow-soft transition-all duration-300">
                    
                    <!-- Formulário Interativo -->
                    <form id="rsvp-form" novalidate class="space-y-6">
                        
                        <!-- Campo 1: Seu nome -->
                        <div>
                            <label for="guest-name" class="block text-base sm:text-[1.05rem] font-bold text-[#3B2E26] mb-2">
                                Seu nome
                            </label>
                            <input type="text" id="guest-name" name="guestName" required placeholder="Digite seu nome completo"
                                   class="w-full bg-white border border-beige-border focus:border-burgundy focus:ring-1 focus:ring-burgundy/30 rounded-[4px] px-4 py-2.5 text-base text-[#3B2E26] placeholder-[#A89B8E] outline-none transition-all">
                            <p id="name-error" class="hidden text-xs sm:text-sm text-red-700 mt-1.5 font-medium">
                                Por favor, informe seu nome para registrar a confirmação.
                            </p>
                        </div>

                        <!-- Campo 2: Quantidade de convidados -->
                        <div>
                            <label for="guest-count" class="block text-base sm:text-[1.05rem] font-bold text-[#3B2E26] mb-2">
                                Quantidade de convidados (incluindo você)
                            </label>
                            <div class="relative">
                                <input type="number" id="guest-count" name="guestCount" value="1" min="1" max="10"
                                       class="w-full bg-white border border-beige-border focus:border-burgundy focus:ring-1 focus:ring-burgundy/30 rounded-[4px] px-4 py-2.5 text-base text-[#3B2E26] outline-none transition-all disabled:bg-[#F2ECE1] disabled:text-[#8C7D70] disabled:cursor-not-allowed">
                            </div>
                            <p id="guest-count-hint" class="hidden text-xs sm:text-sm text-[#7A6A5C] mt-1.5 italic">
                                Quantidade ajustada automaticamente pois você informou que não poderá comparecer.
                            </p>
                        </div>

                        <!-- Campo 3: Você poderá comparecer? -->
                        <div>
                            <span class="block text-base sm:text-[1.05rem] font-bold text-[#3B2E26] mb-2.5">
                                Você poderá comparecer?
                            </span>
                            <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-7">
                                <label class="inline-flex items-center space-x-2.5 cursor-pointer select-none">
                                    <input type="radio" name="attendance" value="Sim, estarei presente" class="custom-radio">
                                    <span class="text-base text-[#4A3B32]">Sim, estarei presente</span>
                                </label>
                                <label class="inline-flex items-center space-x-2.5 cursor-pointer select-none">
                                    <input type="radio" name="attendance" value="Não poderei comparecer" class="custom-radio">
                                    <span class="text-base text-[#4A3B32]">Não poderei comparecer</span>
                                </label>
                            </div>
                            <p id="attendance-error" class="hidden text-xs sm:text-sm text-red-700 mt-1.5 font-medium">
                                Por favor, selecione se você poderá comparecer.
                            </p>
                        </div>

                        <!-- Exibição Dinâmica das Opções de Presentes Selecionadas -->
                        <div id="selected-gifts-preview" class="hidden bg-beige-section/60 border border-beige-border rounded-[4px] p-4 transition-all">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-xs uppercase tracking-widest font-semibold text-burgundy">
                                    Preferências de presente selecionadas
                                </span>
                                <a href="#presentes" class="text-xs underline text-[#6C5D50] hover:text-burgundy">
                                    Alterar
                                </a>
                            </div>
                            <div id="selected-gifts-badges" class="flex flex-wrap gap-2 mt-2">
                                <!-- Badges inseridas via JS -->
                            </div>
                        </div>

                        <!-- Botão de Envio -->
                        <div class="pt-1">
                            <button type="submit" class="w-full bg-burgundy hover:bg-burgundy-dark active:scale-[0.99] text-cream-light font-serif text-base sm:text-[1.05rem] font-medium py-3 px-6 rounded-[4px] shadow-sm transition-all duration-200 tracking-wide">
                                Enviar resposta
                            </button>
                        </div>
                    </form>

                    <!-- Cartão de Confirmação / Resumo Pós-Envio (Oculto inicialmente) -->
                    <div id="rsvp-confirmation" class="hidden text-center space-y-6 animate-fade-up">
                        <div class="w-12 h-12 rounded-full bg-burgundy/10 text-burgundy mx-auto flex items-center justify-center">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>

                        <div>
                            <p class="text-xs uppercase tracking-[0.22em] text-[#7A6A5C] mb-1">
                                RESPOSTA REGISTRADA
                            </p>
                            <h3 class="text-2xl sm:text-3xl font-medium text-burgundy">
                                Obrigado pelo carinho!
                            </h3>
                            <p id="confirmation-subtitle" class="text-base text-[#584A3E] mt-1">
                                Sua confirmação foi salva com sucesso.
                            </p>
                        </div>

                        <!-- Caixa com o Resumo Detalhado -->
                        <div class="bg-white border border-beige-border rounded-[4px] p-5 text-left space-y-3 text-base">
                            <div class="flex justify-between border-b border-beige-border/50 pb-2">
                                <span class="text-[#7A6A5C]">Convidado:</span>
                                <span id="summary-name" class="font-bold text-[#3B2E26]"></span>
                            </div>
                            <div class="flex justify-between border-b border-beige-border/50 pb-2">
                                <span class="text-[#7A6A5C]">Confirmação:</span>
                                <span id="summary-attendance" class="font-bold text-burgundy"></span>
                            </div>
                            <div id="summary-guests-row" class="flex justify-between border-b border-beige-border/50 pb-2">
                                <span class="text-[#7A6A5C]">Quantidade de pessoas:</span>
                                <span id="summary-guests" class="font-bold text-[#3B2E26]"></span>
                            </div>
                            <div class="pt-0.5">
                                <span class="text-[#7A6A5C] block mb-1">Sugestão de presente escolhida:</span>
                                <span id="summary-gifts" class="font-semibold text-[#3B2E26]"></span>
                            </div>
                        </div>

                        <!-- Ações: Copiar para WhatsApp & Editar Resposta -->
                        <div class="flex flex-col sm:flex-row gap-3 pt-2">
                            <button type="button" id="copy-whatsapp-btn"
                                    class="flex-1 inline-flex items-center justify-center gap-2 bg-burgundy hover:bg-burgundy-dark text-cream-light font-serif text-base font-medium py-2.5 px-4 rounded-[4px] transition-colors">
                                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                    <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                                </svg>
                                <span id="copy-btn-text">Copiar resumo para WhatsApp</span>
                            </button>

                            <button type="button" id="edit-rsvp-btn"
                                    class="sm:w-auto inline-flex items-center justify-center border border-burgundy text-burgundy hover:bg-burgundy/5 font-serif text-base font-medium py-2.5 px-5 rounded-[4px] transition-colors">
                                Editar resposta
                            </button>
                        </div>

                        <!-- Feedback de Cópia -->
                        <p id="copy-feedback" class="hidden text-sm text-emerald-800 font-medium">
                            Resumo copiado! Agora é só colar na conversa de WhatsApp com os noivos.
                        </p>
                    </div>

                </div>
            </div>
        </section>
    </main>

    <!-- ==================== RODAPÉ ==================== -->
    <footer class="bg-beige-section border-t border-beige-border/60 py-10 sm:py-12 px-4 text-center">
        <p class="font-script text-3xl sm:text-4xl text-burgundy tracking-wide select-none">
            Com carinho, Natália e Gabryel
        </p>
    </footer>

    <!-- ==================== SCRIPT DE INTERATIVIDADE ==================== -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Elementos da Lista de Presentes
            const giftCards = document.querySelectorAll('.gift-card');
            const selectedGiftsPreview = document.getElementById('selected-gifts-preview');
            const selectedGiftsBadges = document.getElementById('selected-gifts-badges');
            
            // Elementos do Formulário RSVP
            const rsvpForm = document.getElementById('rsvp-form');
            const rsvpConfirmation = document.getElementById('rsvp-confirmation');
            const guestNameInput = document.getElementById('guest-name');
            const guestCountInput = document.getElementById('guest-count');
            const guestCountHint = document.getElementById('guest-count-hint');
            const attendanceRadios = document.querySelectorAll('input[name="attendance"]');
            const nameError = document.getElementById('name-error');
            const attendanceError = document.getElementById('attendance-error');

            // Elementos do Resumo
            const summaryName = document.getElementById('summary-name');
            const summaryAttendance = document.getElementById('summary-attendance');
            const summaryGuestsRow = document.getElementById('summary-guests-row');
            const summaryGuests = document.getElementById('summary-guests');
            const summaryGifts = document.getElementById('summary-gifts');
            const confirmationSubtitle = document.getElementById('confirmation-subtitle');
            const copyWhatsappBtn = document.getElementById('copy-whatsapp-btn');
            const copyBtnText = document.getElementById('copy-btn-text');
            const copyFeedback = document.getElementById('copy-feedback');
            const editRsvpBtn = document.getElementById('edit-rsvp-btn');

            // Estado da aplicação
            let selectedGifts = new Set();
            let lastValidGuestCount = 1;
            let generatedWhatsappText = '';

            // 1. Atualiza visual dos cards de presente e o preview no formulário
            function updateGiftSelectionUI() {
                selectedGifts.clear();

                giftCards.forEach(card => {
                    const checkbox = card.querySelector('.gift-checkbox');
                    const giftName = card.dataset.gift;

                    if (checkbox.checked) {
                        selectedGifts.add(giftName);
                        card.setAttribute('aria-checked', 'true');
                        card.classList.add('border-burgundy', 'ring-1', 'ring-burgundy/40', 'bg-white');
                        card.classList.remove('border-beige-border', 'bg-cream-light');
                    } else {
                        card.setAttribute('aria-checked', 'false');
                        card.classList.remove('border-burgundy', 'ring-1', 'ring-burgundy/40', 'bg-white');
                        card.classList.add('border-beige-border', 'bg-cream-light');
                    }
                });

                // Atualiza o bloco dinâmico dentro do formulário RSVP
                if (selectedGifts.size > 0) {
                    selectedGiftsPreview.classList.remove('hidden');
                    selectedGiftsBadges.innerHTML = '';

                    selectedGifts.forEach(gift => {
                        const badge = document.createElement('span');
                        badge.className = 'inline-flex items-center gap-1.5 bg-white border border-burgundy/30 text-burgundy text-xs sm:text-sm font-medium px-3 py-1 rounded-full shadow-2xs';
                        badge.innerHTML = `
                            <span>${gift}</span>
                            <button type="button" aria-label="Remover ${gift}" class="hover:text-burgundy-dark font-bold ml-1 focus:outline-none">&times;</button>
                        `;
                        badge.querySelector('button').addEventListener('click', () => {
                            toggleGiftByName(gift, false);
                        });
                        selectedGiftsBadges.appendChild(badge);
                    });
                } else {
                    selectedGiftsPreview.classList.add('hidden');
                }
            }

            // Função auxiliar para marcar/desmarcar um presente pelo nome
            function toggleGiftByName(giftName, forceState = null) {
                giftCards.forEach(card => {
                    if (card.dataset.gift === giftName) {
                        const checkbox = card.querySelector('.gift-checkbox');
                        checkbox.checked = forceState !== null ? forceState : !checkbox.checked;
                    }
                });
                updateGiftSelectionUI();
            }

            // Eventos de clique e teclado nos cards de presentes
            giftCards.forEach(card => {
                const checkbox = card.querySelector('.gift-checkbox');

                card.addEventListener('click', (e) => {
                    // Evita duplo disparo se o usuário clicar diretamente no input checkbox ou label
                    if (e.target === checkbox || e.target.closest('label')) {
                        setTimeout(updateGiftSelectionUI, 0);
                        return;
                    }
                    checkbox.checked = !checkbox.checked;
                    updateGiftSelectionUI();
                });

                checkbox.addEventListener('change', updateGiftSelectionUI);

                card.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        checkbox.checked = !checkbox.checked;
                        updateGiftSelectionUI();
                    }
                });
            });

            // 2. Controle inteligente da quantidade de convidados vs. opção de comparecimento
            guestCountInput.addEventListener('change', () => {
                let val = parseInt(guestCountInput.value, 10);
                if (isNaN(val) || val < 1) val = 1;
                if (val > 10) val = 10;
                guestCountInput.value = val;
                lastValidGuestCount = val;
            });

            attendanceRadios.forEach(radio => {
                radio.addEventListener('change', () => {
                    attendanceError.classList.add('hidden');

                    if (radio.value === 'Não poderei comparecer' && radio.checked) {
                        if (!guestCountInput.disabled) {
                            lastValidGuestCount = parseInt(guestCountInput.value, 10) || 1;
                        }
                        guestCountInput.value = 0;
                        guestCountInput.disabled = true;
                        guestCountHint.classList.remove('hidden');
                    } else if (radio.checked) {
                        guestCountInput.disabled = false;
                        guestCountInput.value = lastValidGuestCount >= 1 ? lastValidGuestCount : 1;
                        guestCountHint.classList.add('hidden');
                    }
                });
            });

            guestNameInput.addEventListener('input', () => {
                if (guestNameInput.value.trim().length > 0) {
                    nameError.classList.add('hidden');
                    guestNameInput.classList.remove('border-red-600');
                }
            });

            // 3. Validação e envio do formulário RSVP
            rsvpForm.addEventListener('submit', (e) => {
                e.preventDefault();

                const name = guestNameInput.value.trim();
                const selectedAttendance = document.querySelector('input[name="attendance"]:checked');
                let isValid = true;

                // Valida Nome
                if (!name) {
                    nameError.classList.remove('hidden');
                    guestNameInput.classList.add('border-red-600');
                    guestNameInput.focus();
                    isValid = false;
                } else {
                    nameError.classList.add('hidden');
                    guestNameInput.classList.remove('border-red-600');
                }

                // Valida Presença
                if (!selectedAttendance) {
                    attendanceError.classList.remove('hidden');
                    isValid = false;
                } else {
                    attendanceError.classList.add('hidden');
                }

                if (!isValid) return;

                const willAttend = selectedAttendance.value === 'Sim, estarei presente';
                const count = willAttend ? (parseInt(guestCountInput.value, 10) || 1) : 0;
                const giftsArray = Array.from(selectedGifts);
                const giftsText = giftsArray.length > 0 ? giftsArray.join(', ') : 'Nenhuma opção selecionada';

                // Preenche o cartão de confirmação
                summaryName.textContent = name;
                summaryAttendance.textContent = selectedAttendance.value;

                if (willAttend) {
                    summaryGuestsRow.classList.remove('hidden');
                    summaryGuests.textContent = count === 1 ? '1 pessoa (apenas você)' : `${count} pessoas`;
                    confirmationSubtitle.textContent = 'Ficamos muito felizes em celebrar esse momento especial com você!';
                } else {
                    summaryGuestsRow.classList.add('hidden');
                    confirmationSubtitle.textContent = 'Agradecemos por nos avisar. Sentiremos sua falta nesse dia!';
                }

                summaryGifts.textContent = giftsText;

                // Prepara texto formatado para envio via WhatsApp
                generatedWhatsappText = `Olá Natália & Gabryel! ✨\n\n` +
                    `Segue minha confirmação de presença para o casamento:\n` +
                    `• *Nome:* ${name}\n` +
                    `• *Resposta:* ${selectedAttendance.value}\n` +
                    (willAttend ? `• *Convidados:* ${count}\n` : '') +
                    `• *Sugestão de presente:* ${giftsText}\n\n` +
                    `Com carinho! 🤍`;

                // Alterna visualização entre formulário e resumo
                rsvpForm.classList.add('hidden');
                rsvpConfirmation.classList.remove('hidden');
                copyFeedback.classList.add('hidden');
                copyBtnText.textContent = 'Copiar resumo para WhatsApp';
            });

            // 4. Botão de Copiar Resumo (usando execCommand conforme boas práticas de iframe)
            copyWhatsappBtn.addEventListener('click', () => {
                const tempTextarea = document.createElement('textarea');
                tempTextarea.value = generatedWhatsappText;
                tempTextarea.style.position = 'fixed';
                tempTextarea.style.opacity = '0';
                document.body.appendChild(tempTextarea);
                tempTextarea.select();

                try {
                    document.execCommand('copy');
                    copyBtnText.textContent = 'Resumo copiado!';
                    copyFeedback.classList.remove('hidden');
                } catch (err) {
                    copyBtnText.textContent = 'Erro ao copiar';
                } finally {
                    document.body.removeChild(tempTextarea);
                }
            });

            // 5. Botão Editar Resposta
            editRsvpBtn.addEventListener('click', () => {
                rsvpConfirmation.classList.add('hidden');
                rsvpForm.classList.remove('hidden');
            });
        });
    </script>
</body>
</html>
