                            <path d="M132 28 C115 35, 95 36, 75 30" stroke="currentColor" stroke-width="0.95" stroke-linecap="round"/>
                            <path d="M112 58 C92 68, 70 72, 48 68" stroke="currentColor" stroke-width="0.95" stroke-linecap="round"/>
                            <path d="M96 86 C112 96, 125 110, 132 128" stroke="currentColor" stroke-width="0.95" stroke-linecap="round"/>
                            
                            <!-- Folhas delicadas -->
                            <path d="M142 18 C132 10, 118 12, 114 22 C124 26, 136 24, 142 18 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M148 25 C154 37, 149 52, 138 56 C135 44, 140 32, 148 25 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M118 48 C104 42, 90 47, 86 58 C98 61, 111 56, 118 48 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M126 52 C134 65, 130 81, 119 87 C115 74, 118 61, 126 52 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M98 78 C84 74, 70 81, 67 93 C80 95, 92 89, 98 78 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M74 30 C64 23, 52 25, 47 33 C57 37, 68 35, 74 30 Z" stroke="currentColor" stroke-width="1" fill="#FCF9F2"/>
                            <path d="M48 68 C37 64, 26 68, 22 77 C33 80, 43 76, 48 68 Z" stroke="currentColor" stroke-width="1" fill="#FCF9F2"/>
                            <path d="M106 94 C102 107, 108 120, 118 125 C121 113, 116 101, 106 94 Z" stroke="currentColor" stroke-width="1" fill="#FCF9F2"/>
                            
                            <!-- Pequenos pontos / botões florais -->
                            <circle cx="62" cy="98" r="2" fill="currentColor"/>
                            <circle cx="54" cy="105" r="1.4" fill="currentColor"/>
                            <circle cx="71" cy="106" r="1.3" fill="currentColor"/>
                        </svg>

                        <!-- Ramo Botânico Dourado — Canto Inferior Esquerdo -->
                        <svg class="absolute -bottom-2 -left-2 w-28 h-32 sm:w-36 sm:h-40 text-gold pointer-events-none opacity-90 rotate-180" viewBox="0 0 160 180" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M155 5 C128 32, 105 68, 78 118" stroke="currentColor" stroke-width="1.15" stroke-linecap="round"/>
                            <path d="M132 28 C115 35, 95 36, 75 30" stroke="currentColor" stroke-width="0.95" stroke-linecap="round"/>
                            <path d="M112 58 C92 68, 70 72, 48 68" stroke="currentColor" stroke-width="0.95" stroke-linecap="round"/>
                            <path d="M96 86 C112 96, 125 110, 132 128" stroke="currentColor" stroke-width="0.95" stroke-linecap="round"/>
                            
                            <path d="M142 18 C132 10, 118 12, 114 22 C124 26, 136 24, 142 18 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M148 25 C154 37, 149 52, 138 56 C135 44, 140 32, 148 25 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M118 48 C104 42, 90 47, 86 58 C98 61, 111 56, 118 48 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M126 52 C134 65, 130 81, 119 87 C115 74, 118 61, 126 52 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M98 78 C84 74, 70 81, 67 93 C80 95, 92 89, 98 78 Z" stroke="currentColor" stroke-width="1.05" fill="#FCF9F2"/>
                            <path d="M74 30 C64 23, 52 25, 47 33 C57 37, 68 35, 74 30 Z" stroke="currentColor" stroke-width="1" fill="#FCF9F2"/>
                            <path d="M48 68 C37 64, 26 68, 22 77 C33 80, 43 76, 48 68 Z" stroke="currentColor" stroke-width="1" fill="#FCF9F2"/>
                            <path d="M106 94 C102 107, 108 120, 118 125 C121 113, 116 101, 106 94 Z" stroke="currentColor" stroke-width="1" fill="#FCF9F2"/>
                            
                            <circle cx="62" cy="98" r="2" fill="currentColor"/>
                            <circle cx="54" cy="105" r="1.4" fill="currentColor"/>
                            <circle cx="71" cy="106" r="1.3" fill="currentColor"/>
                        </svg>

                        <!-- Subtítulo superior -->
                        <p class="text-[11px] sm:text-xs tracking-[0.26em] uppercase text-[#7A6A5C] font-medium mb-5 sm:mb-6 z-10">
                            COM AMOR, CONVIDAMOS VOCÊ
                        </p>

                        <!-- Nomes dos Noivos -->
                        <h1 class="font-script text-[3.4rem] sm:text-[4.5rem] leading-[1.06] text-burgundy select-none mb-5 sm:mb-6 z-10">
                            Natália &amp;<br>Gabryel
                        </h1>

                        <!-- Divisor Dourado com Pequeno Coração Bordô -->
                        <div class="flex items-center justify-center w-44 sm:w-52 my-2 sm:my-3 z-10" aria-hidden="true">
                            <span class="h-[1px] flex-1 bg-gold/80"></span>
                            <svg class="w-3.5 h-3.5 mx-3 text-burgundy fill-current" viewBox="0 0 24 24">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                            </svg>
                            <span class="h-[1px] flex-1 bg-gold/80"></span>
                        </div>

                        <!-- Mensagem do Convite -->
                        <div class="space-y-4 text-base sm:text-[1.12rem] leading-relaxed text-[#4E4036] max-w-[360px] mt-3 mb-8 sm:mb-9 z-10">
                            <p>
                                Há histórias que se tornam ainda mais bonitas quando compartilhadas. É com alegria que convidamos você a celebrar o nosso casamento.
                            </p>
                            <p>
                                Sua presença tornará este momento ainda mais especial.
                            </p>
                        </div>

                        <!-- Botão Confirmar Presença -->
                        <a href="#confirmar" class="z-10 inline-flex items-center justify-center bg-burgundy hover:bg-burgundy-dark active:scale-[0.98] text-cream-light font-serif text-base sm:text-[1.05rem] font-medium px-8 py-3 rounded-[4px] shadow-sm transition-all duration-200 tracking-wide">
                            Confirmar presença
