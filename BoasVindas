<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Natália & Gabryel — Convite de Casamento</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Great Vibes (caligráfica) & Cormorant Garamond (serifada clássica) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Great+Vibes&display=swap" rel="stylesheet">

    <!-- Configuração personalizada de cores e fontes no Tailwind -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        cream: {
                            light: '#FCF9F2',
                            base: '#F8F3E8',
                            soft: '#FBF8F1',
                        },
                        beige: {
                            section: '#EFE6D8',
                            border: '#E2D4C0',
                        },
                        burgundy: {
                            DEFAULT: '#581823',
                            dark: '#4A121C',
                            light: '#742331',
                        },
                        gold: {
                            DEFAULT: '#C5A87E',
                            light: '#D8C3A3',
                            dark: '#A6885E',
                        }
                    },
                    fontFamily: {
                        script: ['"Great Vibes"', 'cursive'],
                        serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
                    },
                    boxShadow: {
                        'card': '0 18px 45px -10px rgba(74, 18, 28, 0.14), 0 4px 16px -4px rgba(0, 0, 0, 0.05)',
                        'soft': '0 4px 20px -2px rgba(88, 24, 35, 0.05)',
                    }
                }
            }
        }
    </script>

    <style>
        /* Estilos refinados e micro-interações */
        body {
            background-color: #F8F3E8;
            color: #4A3B32;
            font-family: 'Cormorant Garamond', Georgia, serif;
            overflow-x: hidden;
        }

        /* Gradiente sutil radial de fundo na seção Hero */
        .hero-radial-bg {
            background: radial-gradient(circle at 50% 45%, #EFE6D8 0%, #F8F3E8 55%, #FBF8F1 100%);
        }

        /* Detalhe triangular nos cantos do cartão com leve efeito de dobra/luz */
        .corner-triangle-tl {
            background: linear-gradient(135deg, #4A121C 0%, #6D212F 65%, #3D0D15 100%);
            clip-path: polygon(0 0, 100% 0, 0 100%);
        }

        .corner-triangle-br {
            background: linear-gradient(315deg, #4A121C 0%, #6D212F 65%, #3D0D15 100%);
            clip-path: polygon(100% 100%, 0 100%, 100% 0);
        }

        /* Estilo customizado para checkbox e radio */
        .custom-checkbox {
            appearance: none;
            -webkit-appearance: none;
            width: 1.05rem;
            height: 1.05rem;
            border: 1.5px solid #B5A492;
            border-radius: 3px;
            background-color: #FFFFFF;
            display: inline-grid;
            place-content: center;
            transition: all 0.2s ease;
            cursor: pointer;
            flex-shrink: 0;
        }

        .custom-checkbox:checked {
            background-color: #581823;
            border-color: #581823;
        }

        .custom-checkbox:checked::before {
            content: "";
            width: 0.6rem;
            height: 0.6rem;
            clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
            background-color: #FCF9F2;
        }

        .custom-radio {
            appearance: none;
            -webkit-appearance: none;
            width: 1rem;
            height: 1rem;
            border: 1.5px solid #9E8E7E;
            border-radius: 9999px;
            background-color: #FFFFFF;
            display: inline-grid;
            place-content: center;
            transition: all 0.2s ease;
            cursor: pointer;
            flex-shrink: 0;
        }

        .custom-radio:checked {
            border-color: #581823;
        }

        .custom-radio:checked::before {
            content: "";
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 9999px;
            background-color: #581823;
        }

        /* Animação suave de entrada */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-up {
            animation: fadeUp 0.85s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }
    </style>
</head>
<body class="antialiased selection:bg-burgundy selection:text-cream-light">

    <!-- ==================== CABEÇALHO (NAVBAR) ==================== -->
