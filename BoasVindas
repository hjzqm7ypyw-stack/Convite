                <li>
                    <a href="#confirmar" class="hover:text-burgundy transition-colors py-2 relative after:content-[''] after:absolute after:bottom-1 after:left-0 after:w-0 after:h-[1px] after:bg-burgundy hover:after:w-full after:transition-all">
                        Confirmar presença
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <main>
        <!-- ==================== SEÇÃO HERO / CARTÃO DO CONVITE ==================== -->
